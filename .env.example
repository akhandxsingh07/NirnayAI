# Runtime
NODE_ENV=development
PORT=3000

# Gemini API key for server-side AI advisory + multilingual AI voice.
# Keep this secret. Never use a VITE_ prefix for it.
GEMINI_API_KEY=

# Optional official India Open Government Data API key.
# Used server-side for AGMARKNET/data.gov.in daily mandi price records.
DATA_GOV_IN_API_KEY=

# Single administrator login.
# ADMIN_LOGIN_ID is the username entered on the Admin Portal.
# ADMIN_LOGIN_EMAIL must be the one Supabase Auth user whose profiles.role is admin.
# The admin password itself is stored/verified by Supabase Auth, NOT in this file.
ADMIN_LOGIN_ID=nirnay-admin
ADMIN_LOGIN_EMAIL=

# Supabase public project configuration.
# These values are safe to use in the browser; never place a service-role key here.
SUPABASE_URL=https://nllkmunqdkznhnhfrric.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sEfaduAFppFtdtm5tEAerA_bcpMpbKF

# Vite exposes only VITE_* values to the React client.
VITE_SUPABASE_URL=https://nllkmunqdkznhnhfrric.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sEfaduAFppFtdtm5tEAerA_bcpMpbKF

# IMPORTANT:
# PostgreSQL still enforces the single admin role and private allowlist.
# Never commit Gemini, data.gov.in, SMTP, SMS-provider, admin passwords,
# Supabase service-role keys, or any other server secret.
